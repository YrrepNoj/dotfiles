{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(make build)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(go mod *)",
      "Bash(go build *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl logs *)",
      "Bash(which *)",
      "Bash(nvidia-smi *)",
      "Bash(k3d cluster list)",
      "Bash(git show *)",
      "Bash(git diff *)",
      "Bash(pnpm tsc *)",
      "Bash(uv tree *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./env/.*)",
      "Read(./secrets/**)",
      "Bash(make publish)",
      "Bash(make release)"
    ],
    "ask": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '\"\\(.tool_input.command) - \\(.tool_input.description // \"No description\")\"' >> ~/.claude/bash-command-log.txt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/notify.sh"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/notify.sh --mode permission"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {},
  "sandbox": {
    "enabled": true
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "companyAnnouncements": [
    "Hello nerd",
    "Do something with your life",
    "uggh this guy",
    "try harder",
    "oh, you again.",
    "bro thinks he's a 10x developer",
    "he 100% googles 'how to exit vim' weekly"
  ]
}
