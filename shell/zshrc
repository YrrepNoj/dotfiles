# Personal Utilitiy Functions
grepGoFiles(){
    if [ "$#" -ne 2 ]; then
        GREPPATH="."
    else
        GREPPATH="$2"
    fi
    grep -rnsiI "$1" --include="*.go" "$GREPPATH"
}

grepYamlFiles(){
    if [ "$#" -ne 2 ]; then
        GREPPATH="."
    else
        GREPPATH="$2"
    fi
    grep -rnsiI "$1" --include="*.yaml" --include="*.yml" "$GREPPATH"
}

grepGoAndYamlFiles(){
    if [ "$#" -ne 2 ]; then
        GREPPATH="."
    else
        GREPPATH="$2"
    fi
    grep -rnsiI "$1" --include="*.go" --include="*.yaml" "$GREPPATH"
}

grepMarkdownFiles(){
    if [ "$#" -ne 2 ]; then
        GREPPATH="."
    else
        GREPPATH="$2"
    fi
    grep -rnsiI "$1" --include="*.md" --include="*.mdx" "$GREPPATH"
}

grepPythonFiles(){
    if [ "$#" -ne 2 ]; then
        GREPPATH="."
    else
        GREPPATH="$2"
    fi
    grep -rnsiI "$1" --include="*.py" --include="*.ipynb" "$GREPPATH"
}

findFiles(){
    if [ "$#" -ne 2 ]; then
        FINDPATH="."
    else
        FINDPATH="$2"
    fi
    find "$FINDPATH" -iname "$1"
}


grepHistory(){
    history | grep "$1"
}

