### Terminal and editor
alias vim=nvim

ttt() {
  if [ $# -eq 0 ]; then
    tmux ls
  else
    if [ -n "$TMUX" ]; then
      # This is a nested session to unset the TMUX var and change the styling to make it obvious that it's nested
      TMUX= tmux new-session -A -s "$1" \; set status-style "bg=green" \; set status-fg black
    else
      tmux new-session -A -s "$1"
    fi
  fi
}

dog() {
  # If any argument is -l, enable line numbers
  if [[ " $* " == *" -l "* ]]; then
    # Remove -l from args and run with line numbers
    local args=()
    for arg in "$@"; do
      [[ "$arg" != "-l" ]] && args+=("$arg")
    done
    pygmentize -g -O linenos=1 "${args[@]}"
  else
    pygmentize -g "$@"
  fi
}

### Lima AI sandbox
export AI_SANDBOX_YAML="${AI_SANDBOX_YAML:-$HOME/projects/ellecon/work-automtaion/lima/ai-sandbox.yaml}"
export AI_SANDBOX_BASE="${AI_SANDBOX_BASE:-ai-sandbox-base}"

# Bake the golden image once. --mount-none suppresses the inherited ~ mount
# from template:docker-rootful so $HOME is never exposed and nothing host-path
# pollutes the clones. Stops it after so clones copy a cold, consistent disk.
ai-sandbox-bake() {
  local env_file="$(dirname "$AI_SANDBOX_YAML")/.env"
  if [[ ! -f "$env_file" ]]; then
    echo "ai-sandbox-bake: .env not found at $env_file" >&2
    return 1
  fi
  source "$env_file"
  if [[ -z "${CLAUDE_CODE_NOTIFY_URL:-}" ]]; then
    echo "ai-sandbox-bake: CLAUDE_CODE_NOTIFY_URL not set in $env_file" >&2
    return 1
  fi
  limactl start --name "$AI_SANDBOX_BASE" --mount-none \
    --set ".param.CLAUDE_CODE_NOTIFY_URL = \"$CLAUDE_CODE_NOTIFY_URL\"" \
    "$AI_SANDBOX_YAML" \
    && limactl stop "$AI_SANDBOX_BASE" \
    && echo "Golden image '$AI_SANDBOX_BASE' baked and stopped."
}

# Clone the golden image for the current dir. Instance name defaults to the
# basename of $PWD (override with an arg). Mount is introduced ONLY here.
# Fails fast if an instance with that name already exists.
ai-sandbox-clone() {
  local name="${1:-$(basename "$PWD")}"
  local port
  port=$(_ai_sandbox_free_port)
  if limactl list -q | grep -qx "$name"; then
    echo "ai-sandbox-clone: instance '$name' already exists." >&2
    echo "  Reuse it:  limactl shell $name" >&2
    echo "  Or remove: ai-sandbox-rm $name" >&2
    return 1
  fi
  limactl clone --mount-only "$PWD:w" --start \
    --set ".portForwards[0].hostPort = $port" \
    "$AI_SANDBOX_BASE" "$name" \
    && echo "Cloned '$name' with $PWD mounted writable. TTYD: http://localhost:$port"
}

# Convenience: clone (or reuse) for $PWD, then drop into a shell.
ai-sandbox() {
  local name="${1:-$(basename "$PWD")}"
  limactl list -q | grep -qx "$name" || ai-sandbox-clone "$name" || return 1

  limactl shell "$name"
}

# Find the first TCP port >= 9001 not currently bound on the host.
_ai_sandbox_free_port() {
  local port=9001
  while lsof -iTCP:$port -sTCP:LISTEN -t &>/dev/null; do
    (( port++ ))
  done
  echo $port
}

### Git
alias gtree="git log --graph --oneline --all --decorate --color --abbrev-commit"

# Emits "branch<TAB>path" lines to fzf, shows both columns, returns the path.
# Any args are joined into the initial fzf query, which stays editable; the
# menu always appears so a selection must be confirmed.
_wt_pick() {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    echo "not inside a git repository" >&2
    return 1
  }
  command -v fzf >/dev/null 2>&1 || {
    echo "fzf not found — install it or use: git worktree list" >&2
    return 1
  }

  local sel
  sel=$(git worktree list --porcelain | awk '
    function flush() {
      if (path == "") return
      label = (branch != "") ? branch \
            : (bare ? "(bare)" : (det ? "(detached)" : "?"))
      printf "%s\t%s\n", label, path
    }
    /^worktree / { flush(); path=substr($0, 10); branch=""; det=0; bare=0; next }
    /^branch /   { branch=$2; sub("refs/heads/", "", branch); next }
    /^detached/  { det=1; next }
    /^bare/      { bare=1; next }
    END          { flush() }
  ' | fzf --height=40% --reverse --delimiter='\t' --with-nth=1,2 \
          --query="$*")
  [ -n "$sel" ] || return 1

  # strip the "branch<TAB>" prefix, leaving just the path
  printf '%s\n' "${sel#*$'\t'}"
}

# --- gwtls: list worktrees --------------------------------------------------
unalias gwtls 2>/dev/null
gwtls() {
  git worktree list "$@"
}

# --- gwtcd: jump to a worktree ----------------------------------------------
# usage: gwtcd [filter...]
gwtcd() {
  local dir
  dir=$(_wt_pick "$@") || return
  [ -n "$dir" ] && cd "$dir"
}

# --- gwtm: jump to the main worktree ----------------------------------------
# git always lists the main worktree first.
gwtm() {
  local dir
  dir=$(git worktree list --porcelain 2>/dev/null | awk '/^worktree /{print substr($0, 10); exit}')
  [ -n "$dir" ] || { echo "gwtm: not inside a git repository" >&2; return 1; }
  cd "$dir"
}

# --- gwtrm: remove a worktree -----------------------------------------------
# usage: gwtrm [-f] [-b|-B] [filter...]
#   -f  force removal (untracked/modified files, passed to git worktree remove)
#   -b  also delete the worktree's branch (git branch -d, merged only)
#   -B  also delete the worktree's branch (git branch -D, even if unmerged)
# Refuses to remove the worktree you're currently standing in.
unalias gwtrm 2>/dev/null
gwtrm() {
  local force=0 del_branch="" arg
  local -a query
  for arg in "$@"; do
    case "$arg" in
      -f|--force)  force=1 ;;
      -b|--branch) del_branch=-d ;;
      -B)          del_branch=-D ;;
      -*)          echo "gwtrm: unknown flag: $arg" >&2; return 1 ;;
      *)           query+=("$arg") ;;
    esac
  done

  local dir
  dir=$(_wt_pick "${query[@]}") || return
  [ -n "$dir" ] || return

  # block removal if PWD is the worktree root or anywhere inside it
  case "$PWD/" in
    "$dir"/*)
      echo "gwtrm: you're inside $dir — cd out first (gwtm)" >&2
      return 1
      ;;
  esac

  local branch
  branch=$(git -C "$dir" symbolic-ref --quiet --short HEAD 2>/dev/null)

  local -a rm_args
  [ "$force" -eq 1 ] && rm_args+=(--force)
  if ! git worktree remove "${rm_args[@]}" "$dir"; then
    [ "$force" -eq 0 ] && echo "gwtrm: retry with -f to force removal" >&2
    return 1
  fi
  echo "removed $dir"

  if [ -n "$del_branch" ]; then
    if [ -z "$branch" ]; then
      echo "gwtrm: worktree had no branch (detached); nothing to delete" >&2
    elif ! git branch "$del_branch" "$branch"; then
      [ "$del_branch" = -d ] && echo "gwtrm: use -B to delete the unmerged branch '$branch'" >&2
      return 1
    fi
  fi
}

gwtadd() {
  local do_cd=1 branch="" arg
  for arg in "$@"; do
    case "$arg" in
      --no-cd|-n) do_cd=0 ;;
      -*)         echo "gwtadd: unknown flag: $arg" >&2; return 1 ;;
      *)          if [ -z "$branch" ]; then branch="$arg"
                  else echo "gwtadd: too many arguments" >&2; return 1; fi ;;
    esac
  done
  [ -n "$branch" ] || { echo "usage: gwtadd [--no-cd] <branch>" >&2; return 1; }

  local dest=".worktrees/$branch"

  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    echo "gwtadd: not inside a git repository" >&2; return 1; }

  if [ -e "$dest" ]; then
    echo "gwtadd: path already exists: $dest" >&2; return 1
  fi

  # does the branch already exist locally?
  local has_local=0
  git show-ref --verify --quiet "refs/heads/$branch" && has_local=1

  # if not local, look for a remote-tracking match (origin first)
  local remote="" r
  if [ "$has_local" -eq 0 ]; then
    for r in origin $(git remote | grep -v '^origin$'); do
      if git show-ref --verify --quiet "refs/remotes/$r/$branch"; then
        remote="$r"; break
      fi
    done
  fi

  local rc
  if [ "$has_local" -eq 1 ]; then
    echo "gwtadd: existing local branch '$branch' -> $dest"
    git worktree add "$dest" "$branch"; rc=$?
  elif [ -n "$remote" ]; then
    echo "gwtadd: new branch '$branch' tracking '$remote/$branch' -> $dest"
    git worktree add --track -b "$branch" "$dest" "$remote/$branch"; rc=$?
  else
    echo "gwtadd: new branch '$branch' from HEAD -> $dest"
    echo "        (if you meant an un-fetched remote branch, git fetch first)"
    git worktree add -b "$branch" "$dest"; rc=$?
  fi

  if [ "$rc" -eq 0 ] && [ "$do_cd" -eq 1 ]; then
    cd "$dest"
  fi
  return $rc
}
