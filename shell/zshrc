# Interactive zsh: loads the shared environment, then each module in shell/.
# Another config (such as the Lima AI sandbox) can source this whole file or
# pick individual modules; prompt.zsh must come before the others.
_dotfiles_shell="${${(%):-%N}:A:h}"
source "$_dotfiles_shell/env.zsh"

#   prompt   oh-my-zsh (with compinit) and the prompt theme
#   tools    nvm, pyenv, kubectl completion
#   aliases  kubernetes, docker, notifications, terminal and editor helpers
#   git      gtree and the gwt* worktree commands
#   lima     Lima AI sandbox helpers, where limactl is installed
for _dotfiles_module in prompt tools aliases git lima; do
  source "$_dotfiles_shell/$_dotfiles_module.zsh"
done
unset _dotfiles_shell _dotfiles_module
